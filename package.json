{
    "name": "moos-ivp-editor",
    "displayName": "MOOS-IvP Editor",
    "description": "Editor support for MOOS-IvP mission, behavior, and patch files with syntax highlighting, hover descriptions, semantic highlighting, and conservative diagnostics.",
    "version": "1.0.0",
    "license": "MIT",
    "publisher": "moos-ivp",
    "main": "./src/extension.js",
    "scripts": {
        "build:data": "node scripts/build-inventory.js && node scripts/build-source-descriptions.js && node scripts/build-hover-metadata.js",
        "check": "node --check src/extension.js && node --check src/language-support.js && node --check scripts/build-inventory.js && node --check scripts/build-source-descriptions.js && node --check scripts/build-hover-metadata.js && node --check scripts/audit-diagnostic-schema.js && node --check scripts/check-example-diagnostics.js && node --check scripts/check-geometry-parser-fixtures.js && node --check scripts/check-geometry-diagnostics.js && node scripts/audit-diagnostic-schema.js && node scripts/check-example-diagnostics.js && node scripts/check-geometry-parser-fixtures.js && node scripts/check-geometry-diagnostics.js"
    },
    "activationEvents": [
        "onLanguage:moos",
        "onLanguage:ivp-behavior"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/moos-ivp/vscode-moos-ivp-editor.git"
    },
    "engines": {
        "vscode": "^1.32.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "moos",
                "aliases": [
                    "MOOS",
                    "moos"
                ],
                "extensions": [
                    ".moos",
                    ".xmoos"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "ivp-behavior",
                "aliases": [
                    "IvP Behavior",
                    "ivp-behavior"
                ],
                "extensions": [
                    ".bhv",
                    ".xbhv"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "moos",
                "scopeName": "source.moos",
                "path": "./syntaxes/moos.tmLanguage.json"
            },
            {
                "language": "ivp-behavior",
                "scopeName": "source.bhv",
                "path": "./syntaxes/bhv.tmLanguage.json"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "moos",
                "scopes": {
                    "class.moosApp": [
                        "entity.name.type.moos"
                    ],
                    "class.unknown": [
                        "invalid.illegal.moos"
                    ],
                    "keyword.block": [
                        "keyword.control.moos"
                    ],
                    "macro.directive": [
                        "keyword.preprocessor.moos"
                    ],
                    "property.parameter": [
                        "entity.other.attribute-name.moos"
                    ]
                }
            },
            {
                "language": "ivp-behavior",
                "scopes": {
                    "class.behavior": [
                        "entity.name.type.bhv"
                    ],
                    "class.unknown": [
                        "invalid.illegal.bhv"
                    ],
                    "keyword.block": [
                        "keyword.control.bhv"
                    ],
                    "macro.directive": [
                        "keyword.preprocessor.bhv"
                    ],
                    "property.parameter": [
                        "entity.other.attribute-name.bhv"
                    ]
                }
            }
        ],
        "semanticTokenModifiers": [
            {
                "id": "block",
                "description": "MOOS-IvP block header token."
            },
            {
                "id": "directive",
                "description": "MOOS-IvP preprocessor directive token."
            },
            {
                "id": "moosApp",
                "description": "MOOS app name."
            },
            {
                "id": "behavior",
                "description": "IvP behavior name."
            },
            {
                "id": "parameter",
                "description": "MOOS-IvP configuration parameter."
            },
            {
                "id": "documented",
                "description": "Documented MOOS-IvP item or parameter."
            },
            {
                "id": "sourceBacked",
                "description": "MOOS-IvP item or parameter found in local source."
            },
            {
                "id": "unknown",
                "description": "Unrecognized MOOS-IvP item or parameter."
            }
        ],
        "configurationDefaults": {
            "[moos]": {
                "editor.semanticHighlighting.enabled": true
            },
            "[ivp-behavior]": {
                "editor.semanticHighlighting.enabled": true
            }
        }
    }
}
