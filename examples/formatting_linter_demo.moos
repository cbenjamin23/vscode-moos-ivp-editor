//-------------------------------------------------
// FILE: formatting_linter_demo.moos
// NOTE: Intentionally messy formatting for formatter/linter testing.
//-------------------------------------------------

ServerHost = localhost
ServerPort = 9000
Community = demo
MOOSTimeWarp = 1

ProcessConfig = pHelmIvP
{

  AppTick   = 4 // Quick Fix should preserve this comment
  CommsTick = 4

  // Preferred: preprocessor directives stay at column 0.
#ifdef SIM
  verbose = true
#else
  verbose = false
#endif

  // Intentionally bad: the formatter should move these directives to column 0.
  #ifdef DEBUG_VERBOSE
  verbose_debug = true
  #endif

  behaviors = meta_vehicle.bhv
}

ProcessConfig = pMarineViewer
{
  AppTick      = 4
  CommsTick    = 4
  tiff_file    = viewer_back.tif

  // Full-line comments keep their text, but indentation is normalized.
  left_context = x=0,y=0,scale=1.0
}
